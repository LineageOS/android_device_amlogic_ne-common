## Dynamic partitions
odm                                                     /odm                 erofs   ro                                                                           wait,slotselect,logical,first_stage_mount
odm_dlkm                                                /odm_dlkm            erofs   ro                                                                           wait,slotselect,logical,first_stage_mount
product                                                 /product             ext4    ro,barrier=1                                                                 wait,slotselect,logical,first_stage_mount
system                                                  /system              ext4    ro,barrier=1                                                                 wait,slotselect,logical,first_stage_mount
system_dlkm                                             /system_dlkm         erofs   ro                                                                           wait,slotselect,logical,first_stage_mount
system_ext                                              /system_ext          ext4    ro,barrier=1                                                                 wait,slotselect,logical,first_stage_mount
vendor                                                  /vendor              erofs   ro                                                                           wait,slotselect,logical,first_stage_mount
vendor_dlkm                                             /vendor_dlkm         erofs   ro                                                                           wait,slotselect,logical,first_stage_mount

## Block devices
/dev/block/by-name/factory                              /mnt/vendor/factory  vfat    noatime,nodiratime,nosuid,noexec,dmask=0022                                  wait,check
/dev/block/by-name/metadata                             /metadata            ext4    noatime,nosuid,nodev,nodelalloc,nomblk_io_submit,errors=panic                wait,check,formattable,first_stage_mount
/dev/block/platform/soc/fe08c000.mmc/by-name/misc       /misc                emmc    defaults                                                                     defaults
/dev/block/by-name/oem                                  /oem                 ext4    ro,barrier=1                                                                 wait,slotselect,first_stage_mount
/dev/block/by-name/odm_ext                              /mnt/vendor/odm_ext  ext4    ro,noatime,nosuid,nodev,nodelalloc,nomblk_io_submit,errors=panic             wait,slotselect,first_stage_mount
/dev/block/by-name/param                                /mnt/vendor/param    ext4    noatime,nosuid,nodev,nodelalloc,nomblk_io_submit,errors=panic                wait,check,quota,formattable
/dev/block/by-name/userdata                             /data                f2fs    noatime,discard,nosuid,nodev,reserve_root=32768,fsync_mode=nobarrier         latemount,wait,check,fileencryption=aes-256-xts,keydirectory=/metadata/vold/metadata_encryption,quota,formattable,reservedsize=32M,checkpoint=fs

## Virtual devices
/dev/block/zram0                                        none                 swap    defaults                                                                     wait,zramsize=50%
/dev/block/loop                                         auto                 loop    defaults                                                                     voldmanaged=loop:auto

## Removable devices
/devices/*.sd*/*/block/mmcblk*                                 auto          auto    defaults                                                                     voldmanaged=sdcard1:auto,encryptable=userdata
/devices/*/xhci-hcd.*.auto/usb?/*/host*/target*/block/sd*      auto          auto    defaults                                                                     voldmanaged=usb:auto,encryptable=userdata
/devices/*dwc3/xhci-hcd.*.auto/usb?/*/host*/target*/block/sr*  auto          auto    defaults                                                                     voldmanaged=sr0:auto,encryptable=userdata
