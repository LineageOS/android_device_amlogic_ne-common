prebuilt_etc {
    name: "fstab.amlogic",
    src: select(
        soong_config_variable("amlogic_fstab", "bootdevice"),
        {
            "sdcard": "fstab.sdcard.amlogic",
            "usb": "fstab.usb.amlogic",
            default: "fstab.amlogic",
        },
    ),
    filename: "fstab.amlogic",
    soc_specific: true,
    vendor_ramdisk_available: true,
}

prebuilt_etc {
    name: "init.amlogic.rc",
    src: "init.amlogic.rc",
    sub_dir: "init/hw",
    soc_specific: true,
}

prebuilt_etc {
    name: "init.amlogic.bluetooth.rc",
    src: "init.amlogic.bluetooth.rc",
    sub_dir: "init/hw",
    soc_specific: true,
}

prebuilt_etc {
    name: "init.amlogic.board.rc",
    src: "init.amlogic.board.rc",
    sub_dir: "init/hw",
    soc_specific: true,
}

prebuilt_etc {
    name: "init.amlogic.media.rc",
    src: "init.amlogic.media.rc",
    sub_dir: "init/hw",
    soc_specific: true,
}

prebuilt_etc {
    name: "init.amlogic.usb.rc",
    src: "init.amlogic.usb.rc",
    sub_dir: "init/hw",
    soc_specific: true,
}

prebuilt_etc {
    name: "init.amlogic.wifi.rc",
    src: "init.amlogic.wifi.rc",
    sub_dir: "init/hw",
    soc_specific: true,
}

prebuilt_etc {
    name: "init.recovery.amlogic.rc",
    src: "init.recovery.amlogic.rc",
    sub_dir: "init",
    recovery: true,
}
